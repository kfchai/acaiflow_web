---
import '../styles/global.css';
import Flowi from '../components/Flowi.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AcaiFlow — Eat well, feel good.',
  description = 'Wholesome bowls made seriously good. Wholefood bowls, açaí bowls, sandwiches and longevity smoothies in Kuching, Sarawak.',
} = Astro.props;

const site = Astro.site ?? new URL('https://acaiflow.my');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.jpg', site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.href}#org`,
      name: 'AcaiFlow',
      url: site.href,
      logo: new URL('/logos/logo-magenta.svg', site).href,
      slogan: 'Eat well, feel good',
      sameAs: ['https://instagram.com/acaiflow.my'],
    },
    {
      '@type': 'Restaurant',
      '@id': `${site.href}#green-heights`,
      name: 'AcaiFlow — Green Heights Mall',
      parentOrganization: { '@id': `${site.href}#org` },
      url: site.href,
      image: ogImage,
      servesCuisine: ['Healthy', 'Açaí bowls', 'Salad bowls', 'Smoothies'],
      telephone: '+60138160023',
      priceRange: 'RM15-RM30',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Lot LG09, Ground Floor, Green Heights Mall, 129, Lorong Lapangan Terbang 2',
        addressLocality: 'Kuching',
        addressRegion: 'Sarawak',
        postalCode: '93250',
        addressCountry: 'MY',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '10:00',
          closes: '19:00',
        },
      ],
      hasMenu: new URL('/menu', site).href,
      acceptsReservations: false,
    },
    {
      '@type': 'Restaurant',
      '@id': `${site.href}#kch-airport`,
      name: "AcaiFlow — Kuching Int'l Airport",
      parentOrganization: { '@id': `${site.href}#org` },
      url: site.href,
      image: ogImage,
      servesCuisine: ['Healthy', 'Açaí bowls', 'Salad bowls', 'Smoothies'],
      telephone: '+60128853836',
      priceRange: 'RM15-RM30',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'L2A19, Level 2, Domestic Departure (Airside), Kuching International Airport',
        addressLocality: 'Kuching',
        addressRegion: 'Sarawak',
        postalCode: '93250',
        addressCountry: 'MY',
      },
      hasMenu: new URL('/menu', site).href,
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: 'AcaiFlow',
      publisher: { '@id': `${site.href}#org` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logos/logo-magenta.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AcaiFlow" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AcaiFlow wholesome bowls" />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="MY-13" />
    <meta name="geo.placename" content="Kuching, Sarawak" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Baloo+2:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <Flowi />
  </body>
</html>
