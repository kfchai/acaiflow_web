---
interface Props {
  active?: 'menu' | 'calculator' | 'catering' | 'location' | 'contact';
  variant?: 'hero' | 'sticky' | 'video';
}

const { active, variant = 'sticky' } = Astro.props;

const links = [
  { href: '/#story', label: 'Our Story', key: 'story' },
  { href: '/menu', label: 'Menu', key: 'menu' },
  { href: '/calculator', label: 'Calculator', key: 'calculator' },
  { href: '/catering', label: 'Catering', key: 'catering' },
  { href: '/location', label: 'Location', key: 'location' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];

const headerStyle =
  variant === 'sticky'
    ? 'position:sticky;top:0;z-index:50;background:rgba(251,248,245,0.88);backdrop-filter:blur(12px);border-bottom:1px solid #EFE3CB;'
    : 'position:relative;z-index:50;';

const navStyle =
  variant === 'sticky'
    ? 'max-width:1240px;margin:0 auto;padding:16px 32px;display:flex;align-items:center;gap:32px;'
    : `max-width:1440px;margin:0 auto;padding:22px 48px;display:flex;align-items:center;gap:32px;color:${variant === 'video' ? '#fff' : '#2A2230'};`;

const linkColor = variant === 'video' ? '#fff' : '#2A2230';
const logoSrc = variant === 'video' ? '/logos/logo-cream.svg' : '/logos/logo-magenta.svg';

const orderBtnStyle =
  variant === 'sticky'
    ? 'flex-shrink:0;background:#8C1D5A;color:#fff;padding:11px 22px;border-radius:100px;font-weight:700;font-size:14px;box-shadow:0 6px 18px rgba(140,29,90,0.28);'
    : 'flex-shrink:0;border-radius:100px;padding:11px 22px;font-weight:700;font-size:14px;box-shadow:0 6px 18px rgba(0,0,0,0.16);background:#8C1D5A;color:#fff;';
---

<header style={headerStyle}>
  <nav class="site-nav" style={navStyle}>
    <a href="/" style="display:flex;align-items:center;flex-shrink:0;margin-right:auto;">
      <img class="site-logo" src={logoSrc} alt="AcaiFlow" style="height:52px;width:auto;display:block;" />
    </a>
    <div class="nav-links" style="display:flex;align-items:center;gap:28px;margin-left:auto;font-weight:600;font-size:15px;">
      {links.map((l) =>
        active === l.key ? (
          <a href={l.href} style="color:#8C1D5A;border-bottom:2px solid #8C1D5A;padding-bottom:2px;">{l.label}</a>
        ) : (
          <a href={l.href} style={`color:${linkColor};`}>{l.label}</a>
        )
      )}
    </div>
    <a class="order-btn" href="https://wa.me/60128853836" target="_blank" style={orderBtnStyle}>Order Now</a>
    <button class="nav-burger" aria-label="Open menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
    </button>
  </nav>
  <div class="mobile-menu">
    {links.map((l) => (
      <a href={l.href} class={active === l.key ? 'active' : undefined}>{l.label}</a>
    ))}
  </div>
</header>

<script>
  const burger = document.querySelector('.nav-burger');
  const menu = document.querySelector('.mobile-menu');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
