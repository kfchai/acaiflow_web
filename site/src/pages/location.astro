---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const outlets = [
  {
    name: 'Green Heights Mall',
    address: 'Lot LG09, Ground Floor, Green Heights Mall, 129, Lorong Lapangan Terbang 2, 93250 Kuching, Sarawak',
    hours: 'Daily · 10:00 AM – 7:00 PM',
    phone: '+60 13-816 0023',
    parking: 'Ample mall parking available',
    mapLink: 'https://maps.google.com/?q=Green+Heights+Mall+Kuching',
    image: '/images/store-green-heights.webp',
  },
  {
    name: 'Kuching Int’l Airport',
    address: 'L2A19, Level 2, Domestic Departure (Airside), Kuching International Airport, 93250 Kuching, Sarawak',
    hours: 'Subject to airport flight schedule ✈️',
    phone: '',
    parking: 'Airport parking (landside)',
    mapLink: 'https://maps.google.com/?q=Kuching+International+Airport',
    image: '/images/store-kch-airport.webp',
  },
];
---

<Layout
  title="Locations — Green Heights Mall & Kuching Airport | AcaiFlow"
  description="Find AcaiFlow in Kuching: Green Heights Mall (daily 10 AM–7 PM) and Kuching International Airport, Level 2 Domestic Departure. Order ahead on WhatsApp or GrabFood."
>
  <div style="min-height:100vh;background:#FCF6E8;">

    <Nav active="location" />

    <section style="max-width:1240px;margin:0 auto;padding:56px 32px 24px;text-align:center;">
      <div style="display:inline-flex;background:#FBE7B8;color:#8C1D5A;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;padding:8px 16px;border-radius:100px;margin-bottom:16px;">Find Us · Kuching</div>
      <h1 style="font-size:54px;line-height:1;font-weight:900;letter-spacing:-0.02em;margin:0 0 12px;">Come say hello</h1>
      <p style="font-size:18px;color:#786A80;max-width:520px;margin:0 auto;">Two spots in Kuching, Sarawak — find the one closest to you and drop by for your next bowl.</p>
    </section>

    <section class="g2" style="max-width:1240px;margin:0 auto;padding:32px;display:grid;grid-template-columns:1fr 1fr;gap:28px;">
      {outlets.map((o) => (
        <div style="background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 12px 30px rgba(42,34,48,0.07);">
          <div style="height:240px;position:relative;"><img class="slot" loading="lazy" decoding="async" src={o.image} alt={o.name} /></div>
          <div style="padding:30px;">
            <h2 style="font-size:26px;font-weight:900;letter-spacing:-0.01em;margin:0 0 12px;">{o.name}</h2>
            <p style="font-size:15.5px;line-height:1.6;color:#5C5064;margin:0 0 18px;">{o.address}</p>
            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:22px;">
              <div style="display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;"><span style="width:30px;height:30px;border-radius:9px;background:#FBE7B8;display:inline-flex;align-items:center;justify-content:center;font-size:15px;">🕑</span>{o.hours}</div>
              {o.phone && <div style="display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;"><span style="width:30px;height:30px;border-radius:9px;background:#FBE7B8;display:inline-flex;align-items:center;justify-content:center;font-size:15px;">📞</span>{o.phone}</div>}
              <div style="display:flex;align-items:center;gap:10px;font-size:15px;font-weight:600;"><span style="width:30px;height:30px;border-radius:9px;background:#FBE7B8;display:inline-flex;align-items:center;justify-content:center;font-size:15px;">🅿️</span>{o.parking}</div>
            </div>
            <a href={o.mapLink} target="_blank" style="display:inline-flex;background:#8C1D5A;color:#fff;padding:13px 24px;border-radius:100px;font-weight:800;font-size:15px;">Open in Google Maps</a>
          </div>
        </div>
      ))}
    </section>

    <section style="max-width:1240px;margin:0 auto;padding:48px 32px 88px;">
      <div style="background:#8C1D5A;border-radius:28px;padding:40px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:24px;">
        <div>
          <h2 style="font-size:30px;font-weight:900;color:#fff;margin:0 0 6px;">Order ahead for pickup</h2>
          <p style="font-size:16px;color:rgba(255,255,255,0.8);margin:0;">Skip the wait — order on WhatsApp or GrabFood and collect in-store.</p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href="https://wa.me/60128853836" target="_blank" style="background:#fff;color:#8C1D5A;padding:15px 26px;border-radius:100px;font-weight:800;font-size:15px;">WhatsApp order</a>
          <a href="https://food.grab.com/" target="_blank" style="background:#F6C445;color:#2A2230;padding:15px 26px;border-radius:100px;font-weight:800;font-size:15px;">GrabFood</a>
        </div>
      </div>
    </section>

    <Footer />

  </div>
</Layout>
