---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const wholefood = [
  { name: 'Zen Sleep', price: 'RM19.50', dressing: 'Yuzu Soy*', desc: 'Herb-crusted sea bass, onsen egg, Thai basil tofu, romaine lettuce, mashed sweet potatoes, roasted apple-cider tomato salad, furikake.', tags: ['Light & calming', 'Supports rest'], image: '/images/bowls/zen_sleep.png', macros: { kcal: 312, carbs: 27, protein: 22, fats: 13 } },
  { name: 'Beauty Bowl', price: 'RM19.50', dressing: 'Pesto*', desc: 'Sous-vide chicken breast, Thai basil tofu, scrambled egg white, romaine lettuce, mashed sweet potatoes, sweet corn, roasted beet hummus, seaweed flakes.', tags: ['Nourishing fats', 'Glow-supporting'], image: '/images/bowls/beauty_bowl.png', macros: { kcal: 498, carbs: 41, protein: 28, fats: 25 } },
  { name: 'Plant Protein', price: 'RM21.50', dressing: 'Salsa Verde*', desc: 'Beet root hummus, tempeh chips, romaine lettuce, whole-grain pasta, miso-glazed carrots, edamame, pumpkin wedges, broccoli, seaweed flakes.', tags: ['Balanced plant protein', 'Naturally nourishing'], image: '/images/bowls/plant_protein.png', macros: { kcal: 438, carbs: 59, protein: 21, fats: 13 } },
  { name: 'Energy Bowl', price: 'RM24.50', dressing: 'Harissa*', desc: 'Roasted chicken leg, scrambled egg white, romaine lettuce, whole-grain pasta, sweet corn, half avocado, parmesan cheese.', tags: ['Sustained energy', 'Power for active days'], image: '/images/bowls/energy_bowl.png', macros: { kcal: 489, carbs: 21, protein: 29, fats: 31 } },
  { name: 'Anti-Inflammatory', price: 'RM22.50', dressing: 'Thyme Olive Oil*', desc: 'Herb-crusted sea bass, scrambled egg white, romaine lettuce, brown rice, miso-glazed carrots, king oyster mushroom, power mixed seed.', tags: ['Omega-rich', 'Calms inflammation'], image: '/images/bowls/anti_inflamattor.png', macros: { kcal: 393, carbs: 44, protein: 20, fats: 16 } },
  { name: 'High Protein', price: 'RM21.50', dressing: 'Pesto*', desc: 'Quinoa, sous-vide chicken breast, onsen egg, edamame, mashed sweet potatoes, charred broccoli, furikake.', tags: ['Protein-dense', 'Muscle-supporting fuel'], image: '/images/bowls/high_protein.png', macros: { kcal: 500, carbs: 33, protein: 29, fats: 28 } },
];

const sandwiches = [
  { name: 'Carprese Chicken', price: 'RM25.90', desc: 'Juicy chicken breast, seasonal greens, tomato, pesto, mozzarella, and balsamic glaze.', image: '/images/sandwiches/carprese_chicken.webp' },
  { name: 'Roasted Fuel Chicken', price: 'RM26.90', desc: 'Roasted chicken leg, seasonal greens, roasted pumpkin, pickled radish, and harissa.', image: '/images/sandwiches/roasted_fuel_chicken.webp' },
  { name: 'Classic Beef', price: 'RM28.90', desc: 'Old school classic roast beef, seasonal greens, tomato, pickled cucumbers, cheddar, and yellow mustard.', image: '/images/sandwiches/classic_beef.webp' },
  { name: 'Omega Boost Tuna', price: 'RM25.90', desc: 'Teriyaki tuna, seasonal greens, egg white, pickled cucumbers, cheddar, & honey mustard sauce.', image: '/images/sandwiches/omega_boost_tuna.webp' },
];

const acai = [
  { name: 'Triple G', desc: 'Açaí with granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/triple_g.jpg', bestseller: false },
  { name: 'Island Escape', desc: 'Açaí with chia pudding, granola, cacao nibs, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/island_escape.jpg', bestseller: true },
  { name: 'Let the Mango', desc: 'Açaí with mango base, granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/let_the_mango.jpg', bestseller: false },
  { name: 'Forget Me Nut', desc: 'Açaí with mulberry, mixed nuts, granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/forget_me_nut.jpg', bestseller: false },
  { name: 'Tropical Trouble', desc: 'Mango & coconut base with chia pudding, granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/tropical_trouble.jpg', bestseller: false },
  { name: 'Berry Dragon', desc: 'Dragon fruit base with chia pudding, granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/berry_dragon.jpg', bestseller: false },
  { name: 'Coco Glow', desc: 'Açaí with coconut base, granola, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/coco_glow.jpg', bestseller: true },
  { name: 'Coconut Resist', desc: 'Coconut base with cocoa chia pudding, chocolate granola, cacao nibs, coconut chips & fresh fruits.', image: '/images/acai/coconut_resist.jpg', bestseller: false },
  { name: 'Nutty N’ Nice', desc: 'Açaí with chocolate granola, cacao nibs, coconut chips, almond flakes & fresh fruits.', image: '/images/acai/nutty_n_nice.jpg', bestseller: false },
];

const smoothies = [
  { name: 'Heavenly Kale', price: 'RM23.90', desc: 'Pineapple, banana, kale, honey, plant-based milk. Detoxifies & strengthens immunity.', image: '/images/PHY_0027.jpg' },
  { name: 'Rechargeable Power Kale', price: 'RM23.90', desc: 'Banana, kale, greek yogurt, honey, plant-based milk. Supports muscle recovery.', image: '/images/PHY_0026.jpg' },
  { name: 'Berry Buff', price: 'RM26.90', desc: 'Açaí, banana, almond butter, tahini, protein powder, plant-based milk. Builds lean muscle.', image: '/images/PHY_0028.jpg' },
  { name: 'Super Maca', price: 'RM25.90', desc: 'Banana, honey, almond butter, maca, cacao nibs, plant-based milk. Improves stamina & focus.', image: '/images/PHY_0029.jpg' },
  { name: 'Cloud 9', price: 'RM27.90', desc: 'Coconut milk, pineapple, blue spirulina, chia pudding, granola, coconut. Supports gut health.', image: '/images/PHY_0030.jpg' },
  { name: 'Berry Glow', price: 'RM25.90', desc: 'Blueberry, banana, greek yogurt, honey, collagen, chia seeds, plant-based milk. Skin radiance.', image: '/images/PHY_0025.jpg' },
];
---

<Layout
  title="Menu — Wholefood Bowls, Açaí & Smoothies | AcaiFlow Kuching"
  description="AcaiFlow's seasonal menu: 6 HCL-certified signature wholefood bowls with macros, sourdough focaccia sandwiches, 9 açaí bowls and longevity smoothies. Eat well, feel good."
>
  <div style="min-height:100vh;background:#FCF6E8;">

    <Nav active="menu" />

    <!-- HEADER -->
    <section style="max-width:1240px;margin:0 auto;padding:64px 32px 32px;text-align:center;">
      <div style="display:inline-flex;background:#FBE7B8;color:#8C1D5A;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;padding:8px 16px;border-radius:100px;margin-bottom:18px;">Savor the Season · Spring Menu</div>
      <h1 style="font-size:60px;line-height:1;font-weight:900;letter-spacing:-0.02em;margin:0 0 16px;">The Menu</h1>
      <p style="font-size:19px;line-height:1.55;color:#786A80;max-width:560px;margin:0 auto 28px;">Eat well, feel good with our fresh seasonal menu — light, vibrant, and seriously satisfying.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
        <a href="#wholefood" style="background:#8C1D5A;color:#fff;font-weight:700;font-size:14px;padding:10px 18px;border-radius:100px;">Wholefood Bowls</a>
        <a href="#sandwiches" style="background:#fff;color:#8C1D5A;font-weight:700;font-size:14px;padding:10px 18px;border-radius:100px;border:2px solid #EAD59B;">Sandwiches</a>
        <a href="#acai" style="background:#fff;color:#8C1D5A;font-weight:700;font-size:14px;padding:10px 18px;border-radius:100px;border:2px solid #EAD59B;">Açaí Bowls</a>
        <a href="#beverages" style="background:#fff;color:#8C1D5A;font-weight:700;font-size:14px;padding:10px 18px;border-radius:100px;border:2px solid #EAD59B;">Beverages</a>
      </div>
    </section>

    <!-- WHOLEFOOD BOWLS -->
    <section id="wholefood" style="max-width:1240px;margin:0 auto;padding:56px 32px;">
      <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:8px;">
        <h2 style="font-size:40px;font-weight:900;letter-spacing:-0.02em;margin:0;">Signature Wholefood Bowls</h2>
        <span style="font-size:14px;font-weight:600;color:#8C1D5A;">*Suggested dressing included. Changeable on request.</span>
      </div>
      <p style="font-size:16px;color:#786A80;margin:0 0 32px;">Whole foods made for real life.</p>
      <div class="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        {wholefood.map((b) => (
          <div style="background:#fff;border-radius:24px;padding:22px;display:flex;gap:20px;box-shadow:0 10px 26px rgba(42,34,48,0.06);">
            <div style="width:120px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:12px;">
              <div style="width:120px;height:120px;border-radius:18px;overflow:hidden;"><img class="slot" loading="lazy" decoding="async" src={b.image} alt={b.name} /></div>
              <img src="/images/hcl-badge.png" alt="Healthier Choice — Kementerian Kesihatan Malaysia" title="Healthier Choice certified" style="width:56px;height:56px;display:block;" />
            </div>
            <div style="flex:1;min-width:0;">
              <h3 style="font-size:19px;font-weight:800;margin:0;">{b.name}</h3>
              <p style="font-size:13.5px;line-height:1.5;color:#786A80;margin:8px 0 10px;">{b.desc}</p>
              <div style="font-size:12.5px;font-weight:600;color:#5C5064;margin-bottom:10px;">Dressing: {b.dressing}</div>
              <div style="display:flex;gap:8px;margin-bottom:10px;">
                {[[b.macros.kcal, 'kcal', 'Energy'], [b.macros.carbs + 'g', 'Carbs', ''], [b.macros.protein + 'g', 'Protein', ''], [b.macros.fats + 'g', 'Fats', '']].map(([value, label]) => (
                  <span style="width:52px;height:52px;border-radius:50%;background:#F6C445;color:#2A2230;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;">
                    <b style="font-size:13px;line-height:1;">{value}</b>
                    <span style="font-size:8.5px;font-weight:700;margin-top:2px;">{label}</span>
                  </span>
                ))}
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                {b.tags.map((t) => (
                  <span style="background:#FBE7B8;color:#8C1D5A;font-weight:700;font-size:11.5px;padding:5px 11px;border-radius:100px;">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      <!-- BYO banner -->
      <a href="/calculator" class="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;background:#8C1D5A;border-radius:28px;padding:36px 40px;margin-top:24px;color:#fff;">
        <div>
          <div style="display:inline-flex;background:#F6C445;color:#2A2230;font-family:'Baloo 2',sans-serif;font-weight:800;font-size:13px;padding:6px 13px;border-radius:100px;margin-bottom:14px;">Your Bowl, Your Way!</div>
          <h3 style="font-size:32px;font-weight:900;margin:0 0 8px;color:#fff;">Build Your Own Bowls</h3>
          <p style="font-size:15px;color:rgba(255,255,255,0.82);margin:0;">Select your bases, proteins, supplements, toppings and dressings.</p>
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap;">
          <span style="background:rgba(255,255,255,0.12);border-radius:14px;padding:12px 16px;font-weight:700;">Small</span>
          <span style="background:rgba(255,255,255,0.12);border-radius:14px;padding:12px 16px;font-weight:700;">Regular</span>
          <span style="background:rgba(255,255,255,0.12);border-radius:14px;padding:12px 16px;font-weight:700;">Large</span>
        </div>
      </a>
    </section>

    <!-- SANDWICHES -->
    <section id="sandwiches" style="background:#FBE7B8;padding:64px 0;">
      <div style="max-width:1240px;margin:0 auto;padding:0 32px;">
        <h2 style="font-size:40px;font-weight:900;letter-spacing:-0.02em;margin:0 0 6px;">Wholefood Sandwiches</h2>
        <p style="font-size:16px;color:#786A80;margin:0 0 32px;">Sourdough focaccia — fresh, hearty, made for real life.</p>
        <div class="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          {sandwiches.map((s) => (
            <div style="background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 10px 26px rgba(42,34,48,0.06);">
              <div style="height:280px;background:#fff;"><img class="slot" loading="lazy" decoding="async" style="object-fit:contain;padding:22px 28px;" src={s.image} alt={s.name} /></div>
              <div style="padding:22px;">
                <h3 style="font-size:19px;font-weight:800;margin:0;">{s.name}</h3>
                <p style="font-size:14px;line-height:1.5;color:#786A80;margin:8px 0 0;">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ACAI BOWLS -->
    <section id="acai" style="max-width:1240px;margin:0 auto;padding:64px 32px;">
      <h2 style="font-size:40px;font-weight:900;letter-spacing:-0.02em;margin:0 0 6px;">Açaí Bowls</h2>
      <p style="font-size:16px;color:#786A80;margin:0 0 32px;">All açaí bowls come with your choice of peanut or almond butter drizzle. Add-on: extra drizzle + chia seeds.</p>
      <div class="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
        {acai.map((a) => (
          <div style="background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 10px 26px rgba(42,34,48,0.06);position:relative;">
            {a.bestseller && <span style="position:absolute;top:14px;left:14px;z-index:2;background:#E85C9A;color:#fff;font-family:'Baloo 2',sans-serif;font-weight:800;font-size:11px;padding:6px 11px;border-radius:100px;">BEST SELLER</span>}
            <div style="height:180px;"><img class="slot" loading="lazy" decoding="async" src={a.image} alt={a.name} /></div>
            <div style="padding:22px;">
              <h3 style="font-size:18px;font-weight:800;margin:0 0 8px;">{a.name}</h3>
              <p style="font-size:13.5px;line-height:1.5;color:#786A80;margin:0;">{a.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- BEVERAGES -->
    <section id="beverages" style="background:#4A1039;padding:72px 0;">
      <div style="max-width:1240px;margin:0 auto;padding:0 32px;">
        <div style="text-align:center;margin-bottom:44px;">
          <div style="display:inline-flex;background:rgba(255,255,255,0.12);color:#fff;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;padding:8px 16px;border-radius:100px;margin-bottom:14px;">Tea, smoothie or me?</div>
          <h2 style="font-size:44px;font-weight:900;letter-spacing:-0.02em;margin:0;color:#fff;">Longevity Smoothies</h2>
        </div>
        <div class="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
          {smoothies.map((d) => (
            <div style="border:2px solid rgba(255,255,255,0.22);border-radius:24px;padding:22px;display:flex;gap:18px;align-items:center;">
              <div style="width:74px;height:96px;flex-shrink:0;border-radius:14px;overflow:hidden;"><img class="slot" loading="lazy" decoding="async" src={d.image} alt={d.name} /></div>
              <div style="flex:1;min-width:0;">
                <h3 style="font-size:17px;font-weight:800;margin:0 0 6px;color:#fff;">{d.name}</h3>
                <p style="font-size:12.5px;line-height:1.45;color:rgba(255,255,255,0.62);margin:0;">{d.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <p style="text-align:center;color:rgba(255,255,255,0.6);font-size:14px;margin:32px 0 0;">Add-on super boosters — Cocoa + Monk Fruit Whey, Creatine, Collagen or Protein Powder.</p>
      </div>
    </section>

    <Footer />

  </div>
</Layout>
