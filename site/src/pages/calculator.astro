---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SIZES, DATA, GROUP_META } from '../data/bowl-data';
---

<Layout title="Macro Calculator — AcaiFlow">
  <div style="min-height:100vh;background:#FCF6E8;">

    <Nav active="calculator" />

    <!-- HEADER -->
    <section style="max-width:1240px;margin:0 auto;padding:56px 32px 20px;">
      <div style="display:inline-flex;background:#FBE7B8;color:#8C1D5A;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;padding:8px 16px;border-radius:100px;margin-bottom:16px;">Macro Calculator · Nutrition Info</div>
      <h1 style="font-size:54px;line-height:1;font-weight:900;letter-spacing:-0.02em;margin:0 0 14px;">Build Your Own Wholesome Bowl</h1>
      <p style="font-size:18px;line-height:1.55;color:#786A80;max-width:620px;margin:0;">Pick your size and ingredients — calories and macros update live so you know exactly how your bowl fuels your day. When you eat well, you feel good.</p>
    </section>

    <!-- BUILDER -->
    <section class="gsplit" style="max-width:1240px;margin:0 auto;padding:24px 32px 96px;display:grid;grid-template-columns:1fr 360px;gap:32px;align-items:start;">

      <!-- LEFT: choices -->
      <div>
        <!-- SIZE -->
        <div style="background:#fff;border-radius:24px;padding:26px;box-shadow:0 10px 26px rgba(42,34,48,0.06);margin-bottom:20px;">
          <h2 style="font-size:15px;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#8C1D5A;margin:0 0 16px;">Choose your size</h2>
          <div class="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
            {Object.entries(SIZES).map(([key, s]) => (
              <button class={`size-card${key === 'medium' ? ' on' : ''}`} data-size={key} data-label={s.label}>
                <div style="font-family:'Baloo 2',sans-serif;font-weight:800;font-size:17px;margin-bottom:8px;">{s.label}</div>
                <div style="font-size:12px;line-height:1.5;color:#786A80;font-weight:500;">{s.includes}</div>
              </button>
            ))}
          </div>
        </div>

        <!-- INGREDIENT GROUPS -->
        {Object.entries(DATA).map(([cat, items]) => (
          <div style="background:#fff;border-radius:24px;padding:26px;box-shadow:0 10px 26px rgba(42,34,48,0.06);margin-bottom:20px;">
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:16px;">
              <h2 style="font-size:15px;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#8C1D5A;margin:0;">{GROUP_META[cat].label} <span class="cat-count" data-cat={cat} style="color:#C9BACB;font-size:13px;margin-left:4px;"></span></h2>
              <span style="font-size:12.5px;font-weight:600;color:#786A80;">{GROUP_META[cat].note}</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:10px;">
              {items.map(([id, name, kcal, p, c, f]) => (
                <button class="chip" data-cat={cat} data-id={id} data-name={name} data-kcal={kcal} data-p={p} data-c={c} data-f={f}>
                  <span class="dot"></span>
                  <span>{name}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- RIGHT: live nutrition panel -->
      <div class="calc-panel" style="position:sticky;top:96px;">
        <div style="background:#8C1D5A;border-radius:26px;padding:28px;color:#fff;box-shadow:0 20px 50px rgba(140,29,90,0.28);">
          <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px;">
            <h2 style="font-size:15px;font-weight:800;text-transform:uppercase;letter-spacing:0.06em;color:#F6C445;margin:0;">Your Bowl</h2>
            <span id="size-label" style="font-family:'Baloo 2',sans-serif;font-weight:700;font-size:13px;color:rgba(255,255,255,0.7);">Medium</span>
          </div>
          <div style="display:flex;align-items:flex-end;gap:8px;margin:14px 0 4px;">
            <span id="kcal" style="font-size:56px;font-weight:900;line-height:0.9;">0</span>
            <span style="font-size:16px;font-weight:700;color:rgba(255,255,255,0.7);padding-bottom:8px;">kcal</span>
          </div>
          <div style="font-size:13px;color:rgba(255,255,255,0.6);margin-bottom:22px;"><span id="item-count">0</span> ingredients selected</div>

          <!-- macro bars -->
          <div style="display:flex;flex-direction:column;gap:16px;margin-bottom:24px;">
            <div>
              <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:6px;"><span>Protein</span><span><span id="protein">0</span>g</span></div>
              <div style="height:9px;background:rgba(255,255,255,0.15);border-radius:100px;overflow:hidden;"><div id="bar-p" class="bar-fill" style="height:100%;background:#F6C445;border-radius:100px;width:0%;"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:6px;"><span>Carbs</span><span><span id="carbs">0</span>g</span></div>
              <div style="height:9px;background:rgba(255,255,255,0.15);border-radius:100px;overflow:hidden;"><div id="bar-c" class="bar-fill" style="height:100%;background:#E85C9A;border-radius:100px;width:0%;"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:6px;"><span>Fat</span><span><span id="fat">0</span>g</span></div>
              <div style="height:9px;background:rgba(255,255,255,0.15);border-radius:100px;overflow:hidden;"><div id="bar-f" class="bar-fill" style="height:100%;background:#F19A6B;border-radius:100px;width:0%;"></div></div>
            </div>
          </div>

          <div style="border-top:1px solid rgba(255,255,255,0.16);margin-bottom:20px;"></div>

          <a id="wa-link" href="https://wa.me/60128853836" target="_blank" style="display:block;text-align:center;background:#fff;color:#8C1D5A;padding:15px;border-radius:100px;font-weight:800;font-size:16px;margin-bottom:10px;">Order on WhatsApp</a>
          <button id="reset" style="width:100%;background:transparent;border:1.5px solid rgba(255,255,255,0.3);color:#fff;padding:12px;border-radius:100px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;">Reset bowl</button>
        </div>
        <p style="font-size:12px;line-height:1.5;color:#9A8FA2;margin:14px 4px 0;">Nutrition values are estimates for guidance.</p>
      </div>

    </section>

    <Footer />

  </div>
</Layout>

<script>
  import { SIZES, LIMITS } from '../data/bowl-data';

  const sizeLabels: Record<string, string> = Object.fromEntries(
    Object.entries(SIZES).map(([k, s]) => [k, s.label])
  );

  let size = 'medium';
  let seq = 0; // selection order, used to trim newest-first on downsize

  const el = (id: string) => document.getElementById(id)!;

  const selectedIn = (cat: string) =>
    Array.from(document.querySelectorAll<HTMLButtonElement>(`.chip.on[data-cat="${cat}"]`));

  function applyLimits() {
    const limits = LIMITS[size];
    for (const cat of Object.keys(limits)) {
      const sel = selectedIn(cat);
      const full = sel.length >= limits[cat];
      // limit-1 categories swap instead of locking, so never dim them
      const lock = full && limits[cat] > 1;
      document.querySelectorAll<HTMLButtonElement>(`.chip[data-cat="${cat}"]:not(.on)`).forEach((c) => {
        c.classList.toggle('max', lock);
      });
      const counter = document.querySelector(`.cat-count[data-cat="${cat}"]`);
      if (counter) counter.textContent = sel.length + '/' + limits[cat];
    }
  }

  function trimToLimits() {
    const limits = LIMITS[size];
    for (const cat of Object.keys(limits)) {
      const sel = selectedIn(cat).sort((a, b) => Number(b.dataset.seq) - Number(a.dataset.seq));
      while (sel.length > limits[cat]) sel.shift()!.classList.remove('on');
    }
  }

  function recompute() {
    const chosen = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip.on'));
    let kcal = 0, p = 0, c = 0, f = 0;
    const names: string[] = [];
    for (const chip of chosen) {
      kcal += Number(chip.dataset.kcal);
      p += Number(chip.dataset.p);
      c += Number(chip.dataset.c);
      f += Number(chip.dataset.f);
      names.push(chip.dataset.name!);
    }

    el('kcal').textContent = String(kcal);
    el('protein').textContent = String(p);
    el('carbs').textContent = String(c);
    el('fat').textContent = String(f);
    el('bar-p').style.width = Math.min(100, Math.round((p / 60) * 100)) + '%';
    el('bar-c').style.width = Math.min(100, Math.round((c / 120) * 100)) + '%';
    el('bar-f').style.width = Math.min(100, Math.round((f / 60) * 100)) + '%';
    el('item-count').textContent = String(chosen.length);
    el('size-label').textContent = sizeLabels[size];

    const msg =
      'Hi AcaiFlow! I’d like to order a custom bowl:\n' +
      'Size: ' + sizeLabels[size] + '\n' +
      (names.length ? names.map((n) => '• ' + n).join('\n') : '(no ingredients yet)') + '\n' +
      'Approx: ' + kcal + ' kcal';
    (el('wa-link') as HTMLAnchorElement).href = 'https://wa.me/60128853836?text=' + encodeURIComponent(msg);
  }

  document.querySelectorAll<HTMLButtonElement>('.size-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.size-card').forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      size = btn.dataset.size!;
      trimToLimits();
      applyLimits();
      recompute();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.cat!;
      const limit = LIMITS[size][cat];
      if (!chip.classList.contains('on')) {
        const sel = selectedIn(cat);
        if (sel.length >= limit) {
          if (limit === 1) {
            sel.forEach((c) => c.classList.remove('on')); // swap for single-choice categories
          } else {
            return; // category full
          }
        }
        chip.dataset.seq = String(++seq);
        chip.classList.add('on');
      } else {
        chip.classList.remove('on');
      }
      applyLimits();
      recompute();
    });
  });

  el('reset').addEventListener('click', () => {
    document.querySelectorAll('.chip.on').forEach((c) => c.classList.remove('on'));
    document.querySelectorAll('.size-card').forEach((b) => b.classList.remove('on'));
    document.querySelector('.size-card[data-size="medium"]')!.classList.add('on');
    size = 'medium';
    applyLimits();
    recompute();
  });

  // Preselect from URL (?size=medium&sel=id1,id2,...) — used by Flowi handoff
  const params = new URLSearchParams(location.search);
  const paramSize = params.get('size');
  if (paramSize && LIMITS[paramSize]) {
    size = paramSize;
    document.querySelectorAll('.size-card').forEach((b) => b.classList.remove('on'));
    document.querySelector(`.size-card[data-size="${size}"]`)?.classList.add('on');
  }
  const paramSel = (params.get('sel') || '').split(',').filter(Boolean);
  for (const id of paramSel) {
    const chip = document.querySelector<HTMLButtonElement>(`.chip[data-id="${id}"]`);
    if (chip) {
      chip.dataset.seq = String(++seq);
      chip.classList.add('on');
    }
  }
  trimToLimits();

  applyLimits();
  recompute();
</script>
