---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { name: 'Wholefood Bowls', desc: 'Grains, greens, quality proteins & house dressings.', priceLabel: 'From RM19.50', href: '/menu#wholefood', image: '/images/PHY_0051.jpg', alt: 'Wholefood bowl' },
  { name: 'Wholefood Sandwiches', desc: 'Sourdough focaccia, fresh and hearty.', priceLabel: 'From RM25.90', href: '/menu#sandwiches', image: '/images/sandwiches/sandwich_group.webp', alt: 'Sandwich' },
  { name: 'Açaí Bowls', desc: 'Thick açaí, granola, coconut & fresh fruits.', priceLabel: 'From RM20.90', href: '/menu#acai', image: '/images/PHY_0034.jpg', alt: 'Açaí bowl' },
  { name: 'Longevity Smoothies', desc: 'Kale, berries, protein & super boosters.', priceLabel: 'From RM16.50', href: '/menu#beverages', image: '/images/PHY_0046_bg.jpg', alt: 'Smoothie' },
];
---

<Layout>
  <div style="min-height:100vh;background:#FCF6E8;overflow-x:hidden;">

    <!-- FULL-SCREEN VIDEO HERO + NAV -->
    <div style="position:relative;min-height:100vh;display:flex;flex-direction:column;overflow:hidden;">
      <video autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.jpg" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
        <source src="/video/hero.mp4" type="video/mp4" />
      </video>
      <div style="position:absolute;inset:0;background:linear-gradient(rgba(42,34,48,0.55) 0%,rgba(42,34,48,0.35) 50%,rgba(42,34,48,0.62) 100%);"></div>

      <div style="position:relative;z-index:10;">
        <Nav variant="video" />
      </div>

      <!-- HERO -->
      <section style="position:relative;z-index:2;flex:1;display:flex;align-items:center;width:100%;">
        <div style="max-width:1440px;margin:0 auto;padding:24px 48px 150px;width:100%;">
          <div style="max-width:640px;">
            <h1 class="hero-h1" style="font-size:64px;line-height:0.98;font-weight:900;letter-spacing:-0.02em;margin:0 0 20px;color:#fff;">Wholesome bowls,<br />made <span style="color:#F6C445;">seriously</span> good.</h1>
            <p style="font-size:19px;line-height:1.55;color:rgba(255,255,255,0.85);max-width:440px;margin:0 0 32px;">No strict diets, no boring salads. Just balanced bowls of wholesome grains, fresh veg, quality proteins and homemade dressings — built to help you feel your best.</p>
            <div style="display:flex;gap:14px;flex-wrap:wrap;">
              <a href="/calculator" style="background:#8C1D5A;color:#fff;padding:16px 30px;border-radius:100px;font-weight:800;font-size:16px;box-shadow:0 10px 26px rgba(140,29,90,0.3);">Build your bowl</a>
              <a href="/menu" style="background:#fff;color:#8C1D5A;padding:16px 30px;border-radius:100px;font-weight:800;font-size:16px;">View the menu</a>
            </div>
            <div style="display:flex;gap:28px;margin-top:36px;">
              <div><div style="font-size:26px;font-weight:900;color:#F6C445;">30+</div><div style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.75);">signature bowls</div></div>
              <div style="width:1px;background:rgba(255,255,255,0.25);"></div>
              <div><div style="font-size:26px;font-weight:900;color:#F6C445;">100%</div><div style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.75);">wholefood based</div></div>
              <div style="width:1px;background:rgba(255,255,255,0.25);"></div>
              <div><div style="font-size:26px;font-weight:900;color:#F6C445;">8</div><div style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.75);">homemade dressings</div></div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- MARQUEE RIBBON -->
    <div style="background:#8C1D5A;overflow:hidden;padding:16px 0;">
      <div style="display:flex;width:max-content;animation:marquee 26s linear infinite;">
        <div style="display:flex;align-items:center;gap:0;font-family:'Baloo 2',sans-serif;font-weight:800;font-size:22px;color:#fff;text-transform:uppercase;letter-spacing:0.02em;">
          <span style="padding:0 28px;">Wholefood Bowls</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Wholefood Sandwiches</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Açaí Bowls</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Longevity Smoothies</span><span style="color:#F6C445;">✦</span>
          <span style="padding:0 28px;">Wholefood Bowls</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Wholefood Sandwiches</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Açaí Bowls</span><span style="color:#F6C445;">✦</span><span style="padding:0 28px;">Longevity Smoothies</span><span style="color:#F6C445;">✦</span>
        </div>
      </div>
    </div>

    <!-- OUR STORY -->
    <section id="story" style="position:relative;width:100%;overflow:hidden;">
      <img src="/images/story-family.webp" alt="Family enjoying AcaiFlow bowls together in store" class="story-bg" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(42,34,48,0.85) 0%,rgba(42,34,48,0.62) 55%,rgba(42,34,48,0.35) 100%);"></div>
      <div style="position:relative;max-width:1240px;margin:0 auto;padding:140px 32px;">
        <div style="max-width:620px;">
          <div style="font-family:'Baloo 2',sans-serif;font-weight:700;color:#F6C445;font-size:15px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;">Our Story</div>
          <h2 style="font-size:46px;line-height:1.04;font-weight:900;letter-spacing:-0.02em;margin:0 0 24px;color:#fff;">Eating healthy should be easy.</h2>
          <p style="font-size:18px;line-height:1.65;color:rgba(255,255,255,0.88);margin:0 0 18px;">Eating well isn't always easy — but we believe it should be. That's why we started AcaiFlow: to make wholesome eating simple, so you can focus on feeling your best every day.</p>
          <p style="font-size:18px;line-height:1.65;color:rgba(255,255,255,0.88);margin:0 0 32px;">We bring it together with wholesome grains, fresh vegetables, quality proteins, healthy fats, and homemade dressings — in a seasonal menu that keeps every bowl vibrant and balanced.</p>
          <a href="/calculator" style="display:inline-flex;align-items:center;gap:8px;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:17px;color:#F6C445;">Let's build your bowl →</a>
        </div>
      </div>
    </section>

    <!-- SEASONAL MENU HIGHLIGHTS -->
    <section style="background:#FBE7B8;padding:96px 0;">
      <div style="max-width:1240px;margin:0 auto;padding:0 32px;">
        <div style="text-align:center;max-width:640px;margin:0 auto 56px;">
          <div style="font-family:'Baloo 2',sans-serif;font-weight:700;color:#E85C9A;font-size:15px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;">Savor the Season</div>
          <h2 style="font-size:46px;line-height:1.04;font-weight:900;letter-spacing:-0.02em;margin:0 0 18px;">Our Spring Menu</h2>
          <p style="font-size:18px;line-height:1.6;color:#5C5064;margin:0;">Built to feel light, vibrant, and seriously satisfying — purple sweet potato mash, herb-crusted proteins, avocado, greens, nuts, seeds and homemade dressings.</p>
        </div>
        <div class="g4" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;">
          {categories.map((cat) => (
            <a href={cat.href} style="background:#fff;border-radius:26px;overflow:hidden;box-shadow:0 12px 30px rgba(42,34,48,0.07);display:block;color:#2A2230;">
              <div style="height:200px;position:relative;">
                <img class="slot" src={cat.image} alt={cat.alt} />
              </div>
              <div style="padding:22px 22px 26px;">
                <h3 style="font-size:21px;font-weight:800;margin:0 0 8px;">{cat.name}</h3>
                <p style="font-size:14px;line-height:1.5;color:#786A80;margin:0 0 14px;">{cat.desc}</p>
                <span style="font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;color:#8C1D5A;">{cat.priceLabel}</span>
              </div>
            </a>
          ))}
        </div>
        <div style="text-align:center;margin-top:48px;">
          <a href="/menu" style="background:#8C1D5A;color:#fff;padding:16px 34px;border-radius:100px;font-weight:800;font-size:16px;box-shadow:0 10px 26px rgba(140,29,90,0.28);">See the full menu</a>
        </div>
      </div>
    </section>

    <!-- BUILD YOUR OWN BOWL BANNER -->
    <section style="max-width:1240px;margin:0 auto;padding:96px 32px;">
      <div class="gsplit byo-banner" style="background:#8C1D5A;border-radius:36px;padding:64px 56px;display:grid;grid-template-columns:1fr 0.8fr;gap:48px;align-items:center;position:relative;overflow:hidden;">
        <div style="position:relative;z-index:2;">
          <div style="display:inline-flex;background:#F6C445;color:#2A2230;font-family:'Baloo 2',sans-serif;font-weight:800;font-size:14px;padding:8px 16px;border-radius:100px;margin-bottom:22px;">Your Bowl, Your Way!</div>
          <h2 class="byo-h2" style="font-size:52px;line-height:0.98;font-weight:900;letter-spacing:-0.02em;color:#fff;margin:0 0 18px;">Build your own wholesome bowl.</h2>
          <p style="font-size:18px;line-height:1.6;color:rgba(255,255,255,0.82);max-width:460px;margin:0 0 30px;">Pick your bases, proteins, supplements, toppings and dressings — then see the calories and macros update live. Know exactly what fuels your day.</p>
          <a href="/calculator" style="background:#fff;color:#8C1D5A;padding:16px 32px;border-radius:100px;font-weight:800;font-size:16px;">Open the calculator →</a>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px;position:relative;z-index:2;">
          <div style="display:flex;justify-content:space-between;background:rgba(255,255,255,0.1);border-radius:16px;padding:16px 20px;color:#fff;font-weight:700;"><span>Small</span><span style="color:#F6C445;">RM15.50</span></div>
          <div style="display:flex;justify-content:space-between;background:rgba(255,255,255,0.1);border-radius:16px;padding:16px 20px;color:#fff;font-weight:700;"><span>Regular</span><span style="color:#F6C445;">RM19.50</span></div>
          <div style="display:flex;justify-content:space-between;background:rgba(255,255,255,0.1);border-radius:16px;padding:16px 20px;color:#fff;font-weight:700;"><span>Large</span><span style="color:#F6C445;">RM23.50</span></div>
        </div>
      </div>
    </section>

    <!-- CATERING TEASER -->
    <section style="position:relative;width:100%;overflow:hidden;">
      <img src="/images/catering-counter.webp" alt="AcaiFlow counter with freshly prepared wholefood ingredients" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
      <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(42,34,48,0.85) 0%,rgba(42,34,48,0.6) 55%,rgba(42,34,48,0.3) 100%);"></div>
      <div style="position:relative;max-width:1240px;margin:0 auto;padding:140px 32px;">
        <div style="max-width:620px;">
          <div style="font-family:'Baloo 2',sans-serif;font-weight:700;color:#F6C445;font-size:15px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;">Catering</div>
          <h2 style="font-size:46px;line-height:1.04;font-weight:900;letter-spacing:-0.02em;margin:0 0 22px;color:#fff;">From our kitchen to your event.</h2>
          <p style="font-size:18px;line-height:1.65;color:rgba(255,255,255,0.88);margin:0 0 30px;">Fresh, balanced catering for every occasion. Team meetings, private gatherings or special events — a vibrant spread of wholesome bowls, sandwiches, açaí bowls and fresh beverages.</p>
          <a href="/catering" style="background:#F6C445;color:#2A2230;padding:16px 32px;border-radius:100px;font-weight:800;font-size:16px;">Find out more 🥗</a>
        </div>
      </div>
    </section>

    <!-- LOCATIONS STRIP -->
    <section style="max-width:1240px;margin:0 auto;padding:96px 32px;">
      <div style="text-align:center;margin-bottom:48px;">
        <div style="font-family:'Baloo 2',sans-serif;font-weight:700;color:#E85C9A;font-size:15px;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:14px;">Find Us</div>
        <h2 style="font-size:46px;line-height:1.04;font-weight:900;letter-spacing:-0.02em;margin:0;">Two spots in Kuching</h2>
      </div>
      <div class="g2" style="display:grid;grid-template-columns:1fr 1fr;gap:28px;">
        <div style="border:2px solid #EFE3CB;border-radius:26px;padding:32px;">
          <h3 style="font-size:24px;font-weight:800;margin:0 0 6px;">Green Heights Mall</h3>
          <p style="font-size:15px;color:#786A80;line-height:1.55;margin:0 0 16px;">Lot LG09, Ground Floor, Green Heights Mall<br />129, Lorong Lapangan Terbang 2, 93250 Kuching, Sarawak</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;"><span style="background:#FBE7B8;color:#8C1D5A;font-weight:700;font-size:13px;padding:7px 13px;border-radius:100px;">Daily 10AM – 7PM</span><span style="background:#FBE7B8;color:#8C1D5A;font-weight:700;font-size:13px;padding:7px 13px;border-radius:100px;">+60 13-816 0023</span></div>
        </div>
        <div style="border:2px solid #EFE3CB;border-radius:26px;padding:32px;">
          <h3 style="font-size:24px;font-weight:800;margin:0 0 6px;">Kuching Int'l Airport</h3>
          <p style="font-size:15px;color:#786A80;line-height:1.55;margin:0 0 16px;">L2A19, Level 2, Domestic Departure (Airside)<br />Kuching International Airport, 93250 Kuching, Sarawak</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;"><span style="background:#FBE7B8;color:#8C1D5A;font-weight:700;font-size:13px;padding:7px 13px;border-radius:100px;">Per flight schedule ✈️</span></div>
        </div>
      </div>
    </section>

    <!-- STORE INTERIOR FULL-WIDTH -->
    <section style="width:100%;height:520px;overflow:hidden;">
      <img src="/images/store-airport-interior.webp" alt="Inside the AcaiFlow store at Kuching International Airport" style="width:100%;height:100%;object-fit:cover;display:block;" />
    </section>

    <Footer />

  </div>
</Layout>
